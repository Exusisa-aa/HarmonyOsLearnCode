import { GameStateMachine, GameState } from './engine/GameState';
import { GameLoop } from './engine/GameLoop';
import { CanvasRenderer } from './engine/CanvasRenderer';
import { ResourceManager } from './engine/ResourceManager';
import { PlayerTank, EnemyTank } from './entity/Tank';
import { TileType } from './entity/Terrain';
import { Explosion } from './entity/Explosion';
import { Direction } from './entity/GameEntity';
import { LevelLoader } from './level/LevelLoader';
import { CollisionSystem } from './system/CollisionSystem';
import { AISystem } from './system/AISystem';
import { ScoreManager } from './system/ScoreManager';
import { PowerUpManager } from './system/PowerUpManager';
import { MAX_ENEMIES_ON_FIELD, ENEMY_SPAWN_INTERVAL } from './util/Constants';
export class GameController {
    constructor() {
        this.stateMachine = new GameStateMachine();
        this.gameLoop = new GameLoop();
        this.renderer = new CanvasRenderer();
        this.resourceMgr = new ResourceManager();
        this.collisionSystem = new CollisionSystem();
        this.aiSystem = new AISystem(this.collisionSystem);
        this.scoreMgr = new ScoreManager();
        this.powerUpMgr = new PowerUpManager();
        this.levelLoader = new LevelLoader(this.resourceMgr);
        this.currentLevelNum = 1;
        this.player = new PlayerTank();
        this.enemies = [];
        this.bullets = [];
        this.terrain = [];
        this.explosions = [];
        this.baseRect = { x: 336, y: 1152, width: 48, height: 48 };
        this.isBaseDestroyed = false;
        this.spawnQueue = [];
        this.spawnTimer = 0;
        this.enemySpawnIndex = 0;
        this.spawnPoints = [];
        this.totalEnemyCount = 0;
        this.remainingEnemies = 0;
        this.onStateChange = null;
        this.inputDirection = null;
        this.inputShoot = false;
        this.setupStateMachine();
        this.setupGameLoop();
    }
    init(context) {
        this.resourceMgr.init(context);
        this.scoreMgr.init(context);
    }
    setupStateMachine() {
        this.stateMachine.onEnter(GameState.MENU, () => {
            this.gameLoop.stop();
        });
        this.stateMachine.onEnter(GameState.PLAYING, () => {
            this.gameLoop.start();
        });
        this.stateMachine.onEnter(GameState.PAUSED, () => {
            this.gameLoop.stop();
        });
        this.stateMachine.onEnter(GameState.GAME_OVER, () => {
            this.gameLoop.stop();
            this.scoreMgr.updateHighScore();
        });
        this.stateMachine.onEnter(GameState.LEVEL_COMPLETE, () => {
            this.gameLoop.stop();
        });
    }
    setupGameLoop() {
        this.gameLoop.onUpdate = (dt) => this.update(dt);
        this.gameLoop.onRender = () => this.renderer.render();
    }
    async startNewGame() {
        this.scoreMgr.reset(true);
        this.currentLevelNum = 1;
        this.stateMachine.transition(GameState.LOADING);
        await this.loadLevel(this.currentLevelNum);
        this.stateMachine.transition(GameState.PLAYING);
        this.fireStateChange(GameState.PLAYING);
    }
    async continueGame() {
        const hasSave = await this.scoreMgr.loadProgress();
        if (hasSave) {
            this.currentLevelNum = this.scoreMgr.currentLevel;
        }
        else {
            this.scoreMgr.reset(true);
            this.currentLevelNum = 1;
        }
        this.stateMachine.transition(GameState.LOADING);
        await this.loadLevel(this.currentLevelNum);
        this.stateMachine.transition(GameState.PLAYING);
        this.fireStateChange(GameState.PLAYING);
    }
    async loadLevel(levelNum) {
        const config = this.levelLoader.load(levelNum);
        this.terrain = config.terrain;
        this.spawnQueue = [...config.enemies];
        this.spawnPoints = config.spawnPoints;
        this.totalEnemyCount = config.totalEnemies;
        this.remainingEnemies = config.totalEnemies;
        this.baseRect = config.baseRect;
        this.isBaseDestroyed = false;
        this.player = new PlayerTank();
        this.enemies = [];
        this.bullets = [];
        this.explosions = [];
        this.powerUpMgr.clear();
        this.renderer.clearEntities();
        for (const t of this.terrain) {
            this.renderer.addEntity(t);
        }
        this.spawnInitialEnemies();
        this.spawnTimer = 0;
    }
    spawnInitialEnemies() {
        const count = Math.min(3, this.spawnQueue.length);
        for (let i = 0; i < count; i++) {
            this.spawnNextEnemy();
        }
    }
    spawnNextEnemy() {
        if (this.spawnQueue.length === 0)
            return;
        const type = this.spawnQueue.shift();
        const sp = this.spawnPoints[this.enemySpawnIndex % this.spawnPoints.length];
        this.enemySpawnIndex++;
        const enemy = new EnemyTank(sp.x, sp.y, type);
        this.enemies.push(enemy);
        this.renderer.addEntity(enemy);
    }
    update(dt) {
        if (!this.stateMachine.is(GameState.PLAYING))
            return;
        if (this.isBaseDestroyed) {
            this.stateMachine.transition(GameState.GAME_OVER);
            this.fireStateChange(GameState.GAME_OVER);
            return;
        }
        this.updatePlayer(dt);
        this.updateEnemies(dt);
        this.updateBullets();
        this.powerUpMgr.update(dt, this.player, this.enemies);
        for (const e of this.explosions) {
            e.timer--;
        }
        this.explosions = this.explosions.filter((e) => e.timer > 0);
        this.updateSpawning();
        this.refreshRenderer();
    }
    updatePlayer(dt) {
        if (!this.player.alive)
            return;
        this.player.update(dt);
        if (this.inputDirection !== null) {
            const dir = this.inputDirection;
            this.player.direction = dir;
            const moveDist = this.player.speed * dt;
            const prevX = this.player.x;
            const prevY = this.player.y;
            switch (dir) {
                case Direction.UP:
                    this.player.y -= moveDist;
                    break;
                case Direction.DOWN:
                    this.player.y += moveDist;
                    break;
                case Direction.LEFT:
                    this.player.x -= moveDist;
                    break;
                case Direction.RIGHT:
                    this.player.x += moveDist;
                    break;
            }
            const allTanks = [];
            allTanks.push(this.player);
            for (const e of this.enemies) {
                allTanks.push(e);
            }
            if (!this.collisionSystem.canMoveTo(this.player, this.terrain, allTanks)) {
                this.player.x = prevX;
                this.player.y = prevY;
                this.tryCornering(dir, moveDist, allTanks);
            }
        }
        if (this.inputShoot) {
            const bullet = this.player.shoot();
            if (bullet) {
                bullet.canBreakSteel = this.player.powerActive;
                this.bullets.push(bullet);
                if (this.player.powerActive) {
                    const b2 = this.player.shoot();
                    if (b2) {
                        b2.canBreakSteel = true;
                        this.bullets.push(b2);
                    }
                }
            }
        }
        const collected = this.collisionSystem.checkPowerUpCollection(this.player, this.powerUpMgr.powerUps);
        if (collected) {
            this.powerUpMgr.collect(collected, this.player, this.enemies);
        }
    }
    tryCornering(dir, _moveDist, allTanks) {
        const nudge = 4;
        if (dir === Direction.UP || dir === Direction.DOWN) {
            this.player.x -= nudge;
            if (this.collisionSystem.canMoveTo(this.player, this.terrain, allTanks))
                return;
            this.player.x += nudge * 2;
            if (this.collisionSystem.canMoveTo(this.player, this.terrain, allTanks))
                return;
            this.player.x -= nudge;
        }
        else {
            this.player.y -= nudge;
            if (this.collisionSystem.canMoveTo(this.player, this.terrain, allTanks))
                return;
            this.player.y += nudge * 2;
            if (this.collisionSystem.canMoveTo(this.player, this.terrain, allTanks))
                return;
            this.player.y -= nudge;
        }
    }
    updateEnemies(dt) {
        for (const enemy of this.enemies) {
            if (!enemy.alive)
                continue;
            if (enemy.frozen) {
                enemy.update(dt);
                continue;
            }
            this.aiSystem.updateEnemy(enemy, this.player, this.terrain, this.enemies, this.bullets, dt);
            const moveDist = enemy.speed * dt;
            const prevX = enemy.x;
            const prevY = enemy.y;
            switch (enemy.direction) {
                case Direction.UP:
                    enemy.y -= moveDist;
                    break;
                case Direction.DOWN:
                    enemy.y += moveDist;
                    break;
                case Direction.LEFT:
                    enemy.x -= moveDist;
                    break;
                case Direction.RIGHT:
                    enemy.x += moveDist;
                    break;
            }
            const allTanks = [];
            allTanks.push(this.player);
            for (const e of this.enemies) {
                allTanks.push(e);
            }
            if (!this.collisionSystem.canMoveTo(enemy, this.terrain, allTanks)) {
                enemy.x = prevX;
                enemy.y = prevY;
                enemy.direction = Math.floor(Math.random() * 4);
                enemy.moveTimer = 30 + Math.floor(Math.random() * 60);
            }
            if (this.aiSystem.shouldShoot(enemy, this.player)) {
                const bullet = enemy.shoot();
                if (bullet)
                    this.bullets.push(bullet);
            }
        }
    }
    updateBullets() {
        for (const bullet of this.bullets) {
            if (!bullet.isActive)
                continue;
            bullet.update(0);
            this.collisionSystem.checkBulletCollisions(bullet, this.terrain, this.player, this.enemies, this.bullets, this.baseRect);
            if (!bullet.isActive) {
                this.explosions.push(new Explosion(bullet.x - 19, bullet.y - 19, 25));
            }
        }
        // Handle dead enemies
        for (const enemy of this.enemies) {
            if (!enemy.alive) {
                this.scoreMgr.addKillScore(enemy.enemyType);
                this.remainingEnemies--;
                this.renderer.removeEntity(enemy);
                this.powerUpMgr.tryDrop(enemy.x, enemy.y);
            }
        }
        this.enemies = this.enemies.filter((e) => e.alive);
        // Check base hit
        if (!this.isBaseDestroyed) {
            for (const bullet of this.bullets) {
                if (!bullet.isActive)
                    continue;
                const bx = bullet.x;
                const by = bullet.y;
                const bw = bullet.width;
                const bh = bullet.height;
                if (bx < this.baseRect.x + this.baseRect.width &&
                    bx + bw > this.baseRect.x &&
                    by < this.baseRect.y + this.baseRect.height &&
                    by + bh > this.baseRect.y) {
                    this.isBaseDestroyed = true;
                    this.explosions.push(new Explosion(this.baseRect.x, this.baseRect.y, 25));
                    break;
                }
            }
        }
        // Player death
        if (!this.player.alive) {
            const isDead = this.scoreMgr.loseLife();
            this.explosions.push(new Explosion(this.player.x, this.player.y, 25));
            if (isDead) {
                this.stateMachine.transition(GameState.GAME_OVER);
                this.fireStateChange(GameState.GAME_OVER);
            }
            else {
                this.player = new PlayerTank();
                this.player.makeInvincible();
            }
        }
        // Level complete check
        if (this.remainingEnemies <= 0 && this.spawnQueue.length === 0) {
            let aliveEnemyCount = 0;
            for (const e of this.enemies) {
                if (e.alive)
                    aliveEnemyCount++;
            }
            if (aliveEnemyCount === 0) {
                let remainingBricks = 0;
                for (const t of this.terrain) {
                    if (t.isActive && (t.tileType === TileType.BRICK || t.tileType === TileType.BASE_WALL)) {
                        remainingBricks++;
                    }
                }
                this.scoreMgr.addLevelClearBonus(remainingBricks);
                this.scoreMgr.currentLevel = this.currentLevelNum + 1;
                this.scoreMgr.saveProgress();
                this.stateMachine.transition(GameState.LEVEL_COMPLETE);
                this.fireStateChange(GameState.LEVEL_COMPLETE);
            }
        }
        this.bullets = this.bullets.filter((b) => b.isActive);
    }
    updateSpawning() {
        if (this.spawnQueue.length === 0)
            return;
        let aliveEnemyCount = 0;
        for (const e of this.enemies) {
            if (e.alive)
                aliveEnemyCount++;
        }
        if (aliveEnemyCount >= MAX_ENEMIES_ON_FIELD)
            return;
        this.spawnTimer++;
        if (this.spawnTimer >= ENEMY_SPAWN_INTERVAL) {
            this.spawnTimer = 0;
            this.spawnNextEnemy();
        }
    }
    refreshRenderer() {
        this.renderer.clearEntities();
        for (const t of this.terrain) {
            this.renderer.addEntity(t);
        }
        for (const p of this.powerUpMgr.powerUps) {
            if (p.isActive)
                this.renderer.addEntity(p);
        }
        for (const b of this.bullets) {
            if (b.isActive)
                this.renderer.addEntity(b);
        }
        if (this.player.alive)
            this.renderer.addEntity(this.player);
        for (const e of this.enemies) {
            if (e.alive)
                this.renderer.addEntity(e);
        }
    }
    fireStateChange(state) {
        if (this.onStateChange)
            this.onStateChange(state);
    }
    setDirection(dir) { this.inputDirection = dir; }
    setShoot(shooting) { this.inputShoot = shooting; }
    pause() {
        if (this.stateMachine.is(GameState.PLAYING)) {
            this.stateMachine.transition(GameState.PAUSED);
            this.fireStateChange(GameState.PAUSED);
        }
    }
    resume() {
        if (this.stateMachine.is(GameState.PAUSED)) {
            this.stateMachine.transition(GameState.PLAYING);
            this.fireStateChange(GameState.PLAYING);
        }
    }
    restartLevel() {
        this.stateMachine.transition(GameState.LOADING);
        this.loadLevel(this.currentLevelNum);
        this.stateMachine.transition(GameState.PLAYING);
        this.fireStateChange(GameState.PLAYING);
    }
    nextLevel() {
        this.currentLevelNum++;
        this.stateMachine.transition(GameState.LOADING);
        this.loadLevel(this.currentLevelNum);
        this.stateMachine.transition(GameState.PLAYING);
        this.fireStateChange(GameState.PLAYING);
    }
    get isPlaying() { return this.stateMachine.is(GameState.PLAYING); }
}
